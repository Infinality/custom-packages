+bool QFontEngineFT::dprFontHintingActive() const
+{
+    static const bool enabled =
+            qEnvironmentVariableIntValue("QT_DISABLE_DPR_FONT_HINTING") <= 0;
+    return enabled && FT_IS_SCALABLE(freetype->face);
+}
+
+
 bool QFontEngineFT::shouldUseDesignMetrics(QFontEngine::ShaperFlags flags) const
 {
     if (!FT_IS_SCALABLE(freetype->face))
         return false;
 
+    if (dprFontHintingActive())
+        return true;
+
     return default_hint_style == HintNone || default_hint_style == HintLight || (flags & DesignMetrics);
