+  /**************************************************************************
+   *
+   * @enum:
+   *   TT_SYMMETRIC_RENDERING_XXX
+   *
+   * @description:
+   *   A list of constants used for the @symmetric-rendering property to
+   *   control the ClearType symmetric-rendering state returned by the
+   *   TrueType `GETINFO` bytecode instruction.
+   *
+   * @values:
+   *   TT_SYMMETRIC_RENDERING_OFF ::
+   *     Don't report symmetric rendering.
+   *
+   *   TT_SYMMETRIC_RENDERING_ON ::
+   *     Report symmetric rendering for non-monochrome rendering modes.
+   *     This corresponds to FreeType's traditional behaviour.
+   *
+   *   TT_SYMMETRIC_RENDERING_AUTO ::
+   *     Use the current PPEM and the font's version~1 `gasp` symmetric
+   *     flags.  Symmetric rendering is not reported if the font requests
+   *     symmetric grid fitting without symmetric smoothing.  In all
+   *     other cases, use the traditional FreeType behaviour.
+   */
+#define TT_SYMMETRIC_RENDERING_OFF   0
+#define TT_SYMMETRIC_RENDERING_ON    1
+#define TT_SYMMETRIC_RENDERING_AUTO  2
+
+
+  /**************************************************************************
+   *
+   * @property:
+   *   symmetric-rendering
+   *
+   * @description:
+   *   Controls whether TrueType interpreter version~40 reports ClearType
+   *   symmetric rendering through result bit~18 of the `GETINFO`
+   *   instruction.
+   *
+   *   The default value is @TT_SYMMETRIC_RENDERING_ON, preserving
+   *   FreeType's existing behaviour.
+   *
+   *   @TT_SYMMETRIC_RENDERING_AUTO uses the version~1 `gasp` table at
+   *   the current vertical PPEM.  If
+   *   @FT_GASP_SYMMETRIC_GRIDFIT is set while
+   *   @FT_GASP_SYMMETRIC_SMOOTHING is clear, symmetric rendering is not
+   *   reported.  If there is no `gasp` table, the table doesn't provide
+   *   the symmetric flags, or symmetric smoothing is requested,
+   *   FreeType's traditional behaviour is retained.
+   *
+   * @note:
+   *   This property affects the rasterizer state reported to TrueType
+   *   bytecode.  It does not itself select a rasterizer or rendering
+   *   mode.
+   *
+   *   The property can be used with @FT_Property_Get also.
+   *
+   *   It can be set with the `FREETYPE_PROPERTIES` environment variable,
+   *   using values~0, 1, or~2.
+   *
+   * @example:
+   *   ```
+   *     FT_Library  library;
+   *     FT_UInt     symmetric_rendering = TT_SYMMETRIC_RENDERING_AUTO;
+   *
+   *
+   *     FT_Init_FreeType( &library );
+   *
+   *     FT_Property_Set( library, "truetype",
+   *                              "symmetric-rendering",
+   *                              &symmetric_rendering );
+   *   ```
+   */
 
   /**************************************************************************
    *
