+  /*
+  * Parse five comma-separated hexadecimal LCD filter weights.
+  *
+  * Examples:
+  *
+  *   1c,38,56,38,1c
+  *   1C,38,56,38,1C
+  *   0x1c,0x38,0x56,0x38,0x1c
+  *
+  * Whitespace around values and commas is allowed.
+  *
+  * `weights` is modified only if the complete string is valid.
+  */
+  static FT_Bool
+  ft_lcd_parse_filter_weights( const char*          text,
+                              FT_LcdFiveTapFilter  weights )
+  {
+    FT_LcdFiveTapFilter  parsed;
+    const char*          p;
+    char*                end;
+    FT_UInt              i;
+
+
+    if ( !text || !*text )
+      return 0;
+
+    p = text;
+
+    for ( i = 0; i < FT_LCD_FILTER_FIVE_TAPS; i++ )
+    {
+      FT_Long  value;
+
+
+      /* Skip leading whitespace. */
+      while ( *p == ' '  ||
+        *p == '\t' ||
+        *p == '\r' ||
+        *p == '\n' )
+        p++;
+
+      if ( !*p )
+        return 0;
+
+      /*
+      * Base 16 intentionally allows both
+      *
+      *   1c
+      *
+      * and
+      *
+      *   0x1c
+      */
+      value = ft_strtol( p, &end, 16 );
+
+      if ( end == p || value < 0 || value > 0xFF )
+        return 0;
+
+      parsed[i] = (FT_Byte)value;
+      p         = end;
+
+      /* Skip trailing whitespace. */
+      while ( *p == ' '  ||
+        *p == '\t' ||
+        *p == '\r' ||
+        *p == '\n' )
+        p++;
+
+      if ( i + 1 < FT_LCD_FILTER_FIVE_TAPS )
+      {
+        if ( *p != ',' )
+          return 0;
+
+        p++;
+      }
+      else
+      {
+        /* Nothing except whitespace is allowed after value five. */
+        if ( *p != '\0' )
+          return 0;
+      }
+    }
+
+    /*
+    * Only update the caller's array after all five values
+    * have successfully parsed.
+    */
+    ft_memcpy( weights, parsed, FT_LCD_FILTER_FIVE_TAPS );
+
+    return 1;
+  }
+
