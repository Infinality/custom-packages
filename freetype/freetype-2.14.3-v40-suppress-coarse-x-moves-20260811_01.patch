diff -ru freetype-2.14.3/src/truetype/ttgload.c freetype-2.14.3-suppress-coarse-x-moves/src/truetype/ttgload.c
--- freetype-2.14.3/src/truetype/ttgload.c	2026-03-20 00:34:52.000000000 -0500
+++ freetype-2.14.3-suppress-coarse-x-moves/src/truetype/ttgload.c	2026-08-11 13:28:56.291760869 -0500
@@ -1148,7 +1148,7 @@
              IS_HINTED( loader->load_flags )    )
         {
 #ifdef TT_SUPPORT_SUBPIXEL_HINTING_MINIMAL
-          if ( !loader->exec->backward_compatibility )
+          if ( !loader->exec->suppress_coarse_x_moves )
 #endif
             x = FT_PIX_ROUND( x );
 
@@ -2223,6 +2223,20 @@
       exec = size->context;
 
 #ifdef TT_SUPPORT_SUBPIXEL_HINTING_MINIMAL
+      /*
+       * FreeType v40 approximates ClearType's finer horizontal execution
+       * grid by suppressing coarse x-axis movements.  Keep this independent
+       * of backward compatibility so that INSTCTRL can select native
+       * ClearType semantics without re-enabling whole-pixel x fitting.
+       *
+       * Set this before running the CVT program so `prep' observes the same
+       * x-axis execution policy as glyph programs.
+       */
+      exec->suppress_coarse_x_moves =
+        driver->interpreter_version == TT_INTERPRETER_VERSION_40 &&
+        mode != FT_RENDER_MODE_MONO                              &&
+        !FT_IS_TRICKY( glyph->face );
+
       /* reset backward compatibility; note that */
       /* the CVT program always runs without it  */
       exec->backward_compatibility = 0;
@@ -2287,9 +2301,7 @@
        * font's programming.
        *
        */
-      if ( driver->interpreter_version == TT_INTERPRETER_VERSION_40 &&
-           mode != FT_RENDER_MODE_MONO                              &&
-           !FT_IS_TRICKY( glyph->face )                             )
+      if ( exec->suppress_coarse_x_moves )
         exec->backward_compatibility = ( size->GS.instruct_control & 4 ) ^ 4;
 
 #endif /* TT_SUPPORT_SUBPIXEL_HINTING_MINIMAL */
