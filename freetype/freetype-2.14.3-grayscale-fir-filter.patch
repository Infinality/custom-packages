+  /*
+   * Apply the grayscale FIR filter to a caller-owned bitmap.
+   *
+   * Unlike the ftsmooth.c version, this cannot enlarge the bitmap because
+   * FT_Outline_Get_Bitmap() receives a buffer allocated by the caller.
+   */
+  static void
+  ft_gray_filter_bitmap_in_place( FT_Library        library,
+                                  const FT_Bitmap*  bitmap )
+  {
+    static const FT_Byte  weights[5] =
+    {
+      0x00, 0x15, 0xD0, 0x15, 0x00
+    };
+
+    FT_Memory  memory;
+    FT_Error   error = FT_Err_Ok;
+
+    FT_Byte*   source = NULL;
+    FT_UInt    width;
+    FT_UInt    rows;
+    FT_Int     pitch;
+    FT_UInt    abs_pitch;
+    FT_UInt    x;
+    FT_UInt    y;
+
+
+    if ( !library                       ||
+      !bitmap                        ||
+      !bitmap->buffer                ||
+      bitmap->pixel_mode != FT_PIXEL_MODE_GRAY ||
+      bitmap->num_grays != 256       ||
+      !bitmap->width                 ||
+      !bitmap->rows                  ||
+      !bitmap->pitch )
+      return;
+
+    memory = library->memory;
+    if ( !memory )
+      return;
+
+    width = bitmap->width;
+    rows  = bitmap->rows;
+    pitch = bitmap->pitch;
+
+    abs_pitch = pitch < 0
+    ? (FT_UInt)( -pitch )
+    : (FT_UInt)pitch;
+
+    if ( abs_pitch < width )
+      return;
+
+    /*
+     * The FreeType allocation macros expect local variables named
+     * `memory` and `error`.
+     *
+     * If allocation fails, leave the rendered glyph unchanged rather
+     * than turning a successful render into an error.
+     */
+    if ( FT_QNEW_ARRAY( source, width ) )
+      return;
+
+    for ( y = 0; y < rows; y++ )
+    {
+      FT_Byte*  row;
+
+
+      /*
+       * Chromium/Skia supplies a positive pitch.  The negative-pitch
+       * handling also covers conventional FreeType up-flow bitmaps.
+       */
+      if ( pitch >= 0 )
+        row = bitmap->buffer + (FT_ULong)y * abs_pitch;
+      else
+        row = bitmap->buffer +
+        (FT_ULong)( rows - 1 - y ) * abs_pitch;
+
+      /*
+       * Make a copy because each output sample must be calculated from
+       * the original, unmodified row.
+       */
+      for ( x = 0; x < width; x++ )
+        source[x] = row[x];
+
+      for ( x = 0; x < width; x++ )
+      {
+        FT_UInt  sum = 0;
+        FT_UInt  tap;
+
+
+        for ( tap = 0; tap < 5; tap++ )
+        {
+          FT_Int  sx = (FT_Int)x + 2 - (FT_Int)tap;
+
+
+          if ( sx >= 0 && (FT_UInt)sx < width )
+            sum += (FT_UInt)source[sx] * weights[tap];
+        }
+
+        row[x] = (FT_Byte)( ( sum + 128 ) >> 8 );
+      }
+    }
+
+    FT_FREE( source );
+  }
+
 
