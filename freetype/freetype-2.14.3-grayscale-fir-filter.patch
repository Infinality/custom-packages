@@ -459,6 +459,128 @@
 
 #endif  /* FT_CONFIG_OPTION_SUBPIXEL_RENDERING */
 
+
+/*
+ * Apply a horizontal five-tap FIR filter to an 8-bit grayscale
+ * coverage bitmap.
+ *
+ * Each source pixel is conceptually distributed across five output
+ * pixels.  The output bitmap is expanded by two pixels on each side
+ * so that the filter tails aren't clipped.
+ */
+static FT_Error
+ft_smooth_filter_gray( FT_Renderer  render,
+                       FT_GlyphSlot slot )
+{
+  /*
+   * A fairly mild whole-pixel filter.
+   *
+   * 0x00 + 0x20 + 0xC0 + 0x20 + 0x00 = 0x100.
+   *
+   * Keeping the sum at 0x100 preserves total coverage.
+   */
+  static const FT_Byte  weights[5] =
+  {
+    0x00, 0x15, 0xD0, 0x15, 0x00
+  };
+
+  FT_Bitmap*  bitmap = &slot->bitmap;
+  FT_Memory   memory = render->root.memory;
+  FT_Error    error  = FT_Err_Ok;
+
+  FT_Byte*    filtered = NULL;
+  FT_UInt     src_width;
+  FT_UInt     dst_width;
+  FT_Int      src_pitch;
+  FT_Int      dst_pitch;
+  FT_UInt     y;
+  FT_UInt     x;
+
+
+  if ( bitmap->pixel_mode != FT_PIXEL_MODE_GRAY ||
+    !bitmap->buffer                          ||
+    !bitmap->width                           ||
+    !bitmap->rows )
+    return FT_Err_Ok;
+
+  src_width = bitmap->width;
+  src_pitch = bitmap->pitch;
+
+  /* Protect the width calculation and FreeType's bitmap limits. */
+  if ( src_width > 0xFFFFU - 4U )
+    return FT_THROW( Raster_Overflow );
+
+  dst_width = src_width + 4;
+  dst_pitch = (FT_Int)dst_width;
+
+  if ( FT_ALLOC_MULT( filtered, bitmap->rows, dst_pitch ) )
+    return error;
+
+  for ( y = 0; y < bitmap->rows; y++ )
+  {
+    const FT_Byte*  src;
+    FT_Byte*        dst = filtered + y * dst_pitch;
+
+
+    /*
+     * For positive pitch, buffer points to the top row.
+     * For negative pitch, buffer points to the bottom row.
+     */
+    if ( src_pitch >= 0 )
+      src = bitmap->buffer + y * (FT_UInt)src_pitch;
+    else
+      src = bitmap->buffer +
+      ( bitmap->rows - 1 - y ) * (FT_UInt)( -src_pitch );
+
+    for ( x = 0; x < dst_width; x++ )
+    {
+      FT_UInt  sum = 0;
+      FT_UInt  tap;
+
+
+      /*
+       * Source pixel sx contributes:
+       *
+       *   weights[0] -> sx - 2
+       *   weights[1] -> sx - 1
+       *   weights[2] -> sx
+       *   weights[3] -> sx + 1
+       *   weights[4] -> sx + 2
+       *
+       * Since the destination has two leading padding pixels,
+       * the equivalent lookup is src[x - tap].
+       */
+      for ( tap = 0; tap < 5; tap++ )
+      {
+        FT_Int  sx = (FT_Int)x - (FT_Int)tap;
+
+
+        if ( sx >= 0 && (FT_UInt)sx < src_width )
+          sum += (FT_UInt)src[sx] * weights[tap];
+      }
+
+      /* Divide by 256 with rounding. */
+      dst[x] = (FT_Byte)( ( sum + 128 ) >> 8 );
+    }
+  }
+
+  FT_FREE( bitmap->buffer );
+
+  bitmap->buffer = filtered;
+  bitmap->width  = dst_width;
+  bitmap->pitch  = dst_pitch;
+
+  /*
+   * Two pixels were added before the original bitmap origin.
+   * The advance is intentionally unchanged.
+   */
+  slot->bitmap_left -= 2;
+
+  return FT_Err_Ok;
+}
